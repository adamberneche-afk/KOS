# Installed dependencies (kos-personal/inference-service/package.json's,
# and this repo's own new root package.json's, once either has any). Never
# committed - CI's `npm ci`/`npm install` step regenerates it from the
# lockfile every run.
node_modules/

# Generated by tools/clasp-sync/sync.js — throwaway per-project push
# folders for cas-ccps's 7 Apps Script projects. Never hand-edit or
# commit; re-generate any time with `node tools/clasp-sync/sync.js`.
cas-ccps/.clasp-build/

# Real clasp config, once created from the .clasp.json.template files —
# contains a live scriptId, which is environment-specific, not repo
# content, consistent with this repo's existing convention of keeping
# real IDs in runtime config (Script Properties) rather than committed
# source. See meta/CLASP_AND_APPS_SCRIPT.md for the workflow.
.clasp.json
.clasprc.json
cas-ccps/clasp/local/

# Real environment files, once created from kos-personal/inference-service's
# .env.example — these hold live OAuth client secrets, the Anthropic and
# Stripe API keys, the database URL and TOKEN_ENCRYPTION_KEY. The service's
# own deployment doc tells operators to `cp .env.example .env` in the repo
# working tree, so without this rule the very next `git add -A` commits
# every one of those credentials.
.env
.env.*
!.env.example
