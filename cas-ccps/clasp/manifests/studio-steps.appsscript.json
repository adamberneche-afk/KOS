{
  "timeZone": "America/New_York",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/documents",
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "addOns": {
    "common": {
      "name": "CAS-CCPS Studio Steps",
      "logoUrl": "REPLACE_WITH_A_HOSTED_LOGO_URL",
      "useLocaleFromApp": true,
      "layoutProperties": {
        "primaryColor": "#1a73e8"
      }
    },
    "flows": {
      "workflowElements": [
        {
          "id": "commitRubricDraft",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Commit Rubric Draft",
          "description": "Parses and validates the rubric-extraction JSON produced by a prior Ask Gemini step, generates a ConfigID, and appends a DRAFT row to the teacher's Teacher Matrix. Use as the last step of Flow 1 (Rubric Extraction), after the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "geminiJsonOutput",
                "description": "The raw JSON text produced by Flow 1's Ask Gemini step (FLOW_1_SYSTEM_PROMPT output).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "teacherMatrixSsId",
                "description": "Spreadsheet ID of the teacher's personal Teacher Matrix (RubricQueue.TeacherMatrixSsId).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "teacherEmail",
                "description": "Instructor email for this rubric (RubricQueue.TeacherEmail).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "promptTemplateId",
                "description": "Drive file ID of the assignment prompt template (RubricQueue.PromptTemplateID).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "subject",
                "description": "Course subject (RubricQueue.Subject).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "courseName",
                "description": "Course name (RubricQueue.CourseName).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "tier",
                "description": "Academic tier (RubricQueue.Tier).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "configId",
                "description": "The generated VDOE-XXXXXXXX-YYYY ConfigID, empty if validation failed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "status",
                "description": "DRAFT_WRITTEN or VALIDATION_FAILED.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "errorDetail",
                "description": "Empty on success; explains what was wrong with the Gemini JSON on failure.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onCommitRubricDraftConfig",
            "onExecuteFunction": "onCommitRubricDraftExecute"
          }
        },
        {
          "id": "readInstructorConfig",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Read Instructor Config",
          "description": "Resolves a ConfigID + StudentFileID into everything Flow 2 needs downstream: student email, teacher email, unit/tier/persona, all 4 milestone texts, definition of done, and all 4 milestone competency IDs. Implements the Ledger -> MatrixRegistry -> TeacherMatrix lookup chain from Flow 2 Step 2. Use right after Flow 2's Starter, before the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "ledgerSsId",
                "description": "Central Ledger spreadsheet ID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "configId",
                "description": "ConfigID (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "studentFileId",
                "description": "Student submission doc ID (trigger row) — required to uniquely identify the Ledger row, since ConfigID alone is shared by every student assigned the same rubric.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "studentEmail",
                "description": "Ledger.GoogleID for the matched row.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "teacherEmail",
                "description": "Ledger.TeacherEmail for the matched row.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "unitName",
                "description": "TeacherMatrix.UnitName for this ConfigID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "tier",
                "description": "TeacherMatrix.Tier for this ConfigID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "persona",
                "description": "TeacherMatrix.Persona for this ConfigID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone1Text",
                "description": "TeacherMatrix.Milestone1 criterion text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone2Text",
                "description": "TeacherMatrix.Milestone2 criterion text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone3Text",
                "description": "TeacherMatrix.Milestone3 criterion text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone4Text",
                "description": "TeacherMatrix.Milestone4 criterion text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "definitionOfDone",
                "description": "TeacherMatrix.DOD text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone1CompetencyId",
                "description": "TeacherMatrix.Milestone1_Competency_Id — blank if not yet confirmed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone2CompetencyId",
                "description": "TeacherMatrix.Milestone2_Competency_Id — blank if not yet confirmed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone3CompetencyId",
                "description": "TeacherMatrix.Milestone3_Competency_Id — blank if not yet confirmed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "milestone4CompetencyId",
                "description": "TeacherMatrix.Milestone4_Competency_Id — blank if not yet confirmed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "lookupStatus",
                "description": "OK, LEDGER_ROW_NOT_FOUND, MATRIX_REGISTRY_ROW_NOT_FOUND, or TEACHER_MATRIX_ASSIGNMENT_NOT_FOUND. Gate Step 3 on this being OK.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onReadInstructorConfigConfig",
            "onExecuteFunction": "onReadInstructorConfigExecute"
          }
        },
        {
          "id": "selectWarmUpArchetype",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Select Warm-Up Archetype",
          "description": "Flow 3's pre-processing step, required by the spec's own words to be code, not Gemini: parses both WarmUpQueue snapshot columns, selects an archetype (shadow matrix override, then decision table, then fallback), selects Mode A/B, and formats every prompt-template variable both system prompts need. Use right after Flow 3's Starter, before the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "lessonContextSnapshotJson",
                "description": "lesson_context_snapshot (trigger row)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "studentProfileSnapshotJson",
                "description": "student_profile_snapshot (trigger row)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "selectionStatus",
                "description": "OK, LESSON_SNAPSHOT_PARSE_FAILED, or PROFILE_SNAPSHOT_PARSE_FAILED. Gate the Gemini call on this being OK.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "mode",
                "description": "A (anchor-aware) or B (generative) — routes to the matching system prompt.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "archetype",
                "description": "PARADOX, CONCRETE_SCENARIO, BRIDGE, or PROVOCATION.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "firstName",
                "description": "Student's first name.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "warmupAnchor",
                "description": "Mode A only — empty in Mode B.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pacingUnitName",
                "description": "Mode A only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pacingStage",
                "description": "Mode A only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "courseObjective",
                "description": "Mode A only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pacingPriorConnection",
                "description": "Mode A only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pacingKeyVocabulary",
                "description": "Mode A only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "courseName",
                "description": "Both modes.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "objective",
                "description": "Both modes.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "activity",
                "description": "Both modes.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "vocabulary",
                "description": "Both modes.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "priorConnection",
                "description": "Both modes.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "competencyTextsFormatted",
                "description": "Formatted from competency_rubrics or competency_texts, whichever the snapshot has.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "competencyGapsFormatted",
                "description": "Comma-joined competency_gaps, or 'None'.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "evaluationSignalsFormatted",
                "description": "Readable multi-line summary of evaluation_signals.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "avgEngagementScore",
                "description": "Numeric, as a string.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "extraCreditCount",
                "description": "Numeric, as a string.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "shadowArchetypeNote",
                "description": "Mode A only — empty if not present in the snapshot.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "competenciesAddressedCount",
                "description": "Mode B only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "totalCompetencies",
                "description": "Mode B only.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onSelectWarmUpArchetypeConfig",
            "onExecuteFunction": "onSelectWarmUpArchetypeExecute"
          }
        },
        {
          "id": "createWarmUpDoc",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Create Warm-Up Doc",
          "description": "Flow 3's post-processing step: resolves the student's warm-up folder, creates the doc, stamps Zone 1 (Prompt) and Zone 2 (Response, blank) with the spec's exact markers and formatting, shares it with the student, and writes doc_id/doc_url/status back to WarmUpQueue — status = ERROR on any failure, per the spec's own stated error philosophy for this flow. Use as the last step of Flow 3, after the native Ask Gemini step. Prepends bridge_output (Flow 5's output) before Zone 1 when present, with a separator line.",
          "workflowAction": {
            "inputs": [
              {
                "id": "ledgerSsId",
                "description": "Central Ledger spreadsheet ID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "queueId",
                "description": "Queue_ID (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "lessonContextSnapshotJson",
                "description": "lesson_context_snapshot (trigger row) — re-parsed here for course_name/teacher_name/period/admin_root_folder_id.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "studentGoogleId",
                "description": "Google_ID (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "studentName",
                "description": "Student_Name (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "firstName",
                "description": "From Select Warm-Up Archetype step's output.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "lessonDate",
                "description": "Lesson_Date (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "generatedPromptText",
                "description": "The native Ask Gemini step's raw output — the generated warm-up text.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "bridgeOutput",
                "description": "bridge_output (col 21, trigger row) — from Flow 5. Leave unmapped, or map to an empty string, if Flow 5 isn't wired into this flow or the student has no prior response.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "writeStatus",
                "description": "SUCCESS, LESSON_SNAPSHOT_PARSE_FAILED, FOLDER_PATH_FIELDS_MISSING, DOC_CREATE_FAILED, DOC_SHARE_FAILED, or QUEUE_ROW_NOT_FOUND_AFTER_DOC_CREATE.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onCreateWarmUpDocConfig",
            "onExecuteFunction": "onCreateWarmUpDocExecute"
          }
        },
        {
          "id": "extractWarmUpPromptText",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Extract Warm-Up Prompt Text",
          "description": "Flow 4's input-preparation step: extracts the exact Zone 1 prompt text from the warm-up doc's raw body (byte-identical to what the student saw), matching evaluateWarmUpDoc_()'s own extraction in 25_WarmUpWriter.js. Use right after a native 'Docs — get document' step, before the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "rawDocText",
                "description": "The native Docs — get document step's output.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "extractStatus",
                "description": "OK or PROMPT_MARKERS_NOT_FOUND. Gate the Gemini call on this being OK.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "promptText",
                "description": "The exact Zone 1 prompt text, or empty if extraction failed.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onExtractWarmUpPromptTextConfig",
            "onExecuteFunction": "onExtractWarmUpPromptTextExecute"
          }
        },
        {
          "id": "finalizeWarmUpScore",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Finalize Warm-Up Score",
          "description": "Flow 4's output step, and the actual implementation behind Script 25's callFlow4_() stub (25_WarmUpWriter.js — confirmed returning null in the current code). Computes the total score, writes final fields to WarmUpQueue, stamps feedback into the doc's Zone 3, and updates the matching WarmUpRegistry row. Use as the last step of Flow 4, after the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "ledgerSsId",
                "description": "Central Ledger spreadsheet ID.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "queueId",
                "description": "Queue_ID (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "fileId",
                "description": "Doc_ID (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "wordCountScore",
                "description": "Word_Count_Score (trigger row — already computed by Script 25's writePreEvalScores_).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "extraCredit",
                "description": "Extra_Credit (trigger row — already computed by Script 25).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "geminiEvalOutput",
                "description": "Raw JSON text from the native Ask Gemini step: {grammar, engagement, feedback}.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "writeStatus",
                "description": "SUCCESS, SUCCESS_DOC_FEEDBACK_WRITE_FAILED, GEMINI_JSON_PARSE_FAILED, or QUEUE_ROW_NOT_FOUND.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "registryUpdateStatus",
                "description": "OK, SKIPPED, REGISTRY_ROW_NOT_FOUND, or REGISTRY_UPDATE_ERROR: <detail> — non-blocking either way; see this step's own file header.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onFinalizeWarmUpScoreConfig",
            "onExecuteFunction": "onFinalizeWarmUpScoreExecute"
          }
        },
        {
          "id": "extractBridgeInputs",
          "state": "PUBLISHED",
          "name": "CAS-CCPS: Extract Bridge Inputs",
          "description": "Flow 5's (Bridging Flow) input-preparation step: pulls flow5_prior_response, pacing_prior_connection, and course_name out of the raw lesson_context_snapshot JSON for the native Ask Gemini step. Use right after Flow 5's Starter, before the native Ask Gemini step.",
          "workflowAction": {
            "inputs": [
              {
                "id": "lessonContextSnapshotJson",
                "description": "lesson_context_snapshot (trigger row).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "extractStatus",
                "description": "OK, LESSON_SNAPSHOT_PARSE_FAILED, or NO_PRIOR_RESPONSE_IN_SNAPSHOT (defense in depth — the trigger's own condition should already prevent this). Gate the Gemini call on this being OK.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "flow5PriorResponse",
                "description": "The student's prior warm-up response text (capped at 800 chars in the snapshot).",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pacingPriorConnection",
                "description": "How today connects to the prior lesson.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "courseName",
                "description": "Course name.",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onExtractBridgeInputsConfig",
            "onExecuteFunction": "onExtractBridgeInputsExecute"
          }
        }
      ]
    }
  }
}
