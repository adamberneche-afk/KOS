# ================================================================
# kos-inference-service — environment template
# ================================================================
# Copy to .env and fill in. INFERENCE_SERVICE_DEPLOYMENT.md has always
# told operators to run `cp .env.example .env` here, but this file did
# not exist, so that step failed and every variable below had to be
# rediscovered by grepping src/. Values shown after `=` are the defaults
# baked into the code; a variable with no value has no default and must
# be supplied.
#
# .env is gitignored (see the repo root .gitignore). Never commit a
# filled-in copy — this file holds only placeholders.

# ── Required: the service refuses to boot without these ──────────
# 32 bytes, hex or base64: `openssl rand -hex 32`. Encrypts the OAuth
# access/refresh tokens at rest in users.access_token/refresh_token.
# Losing it makes every stored token undecryptable — back it up.
TOKEN_ENCRYPTION_KEY=
# Shared secret the KOS Turnstile signs POST /api/v1/jobs with.
# `openssl rand -hex 32`. Required whenever NODE_ENV=production.
WEBHOOK_SECRET=
# postgres://user:pass@host:5432/db — schema applied by `npm run migrate`.
DATABASE_URL=

# ── Required for the service to do its job ───────────────────────
# console.anthropic.com. The SDK does not fail at startup without it;
# the first job to reach runInference does.
ANTHROPIC_API_KEY=
# Google OAuth client (Drive access on the operator's behalf).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the OAuth client,
# e.g. https://your-service.onrender.com/auth/callback
GOOGLE_REDIRECT_URI=

# ── Required only if billing is switched on ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CREATOR=

# ── Optional, shown with their in-code defaults ──────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# No date suffix on current model ids. claude-sonnet-5 and
# claude-haiku-4-5 are the cheaper alternatives.
ANTHROPIC_MODEL=claude-opus-5
# PEM for a database that needs an explicit CA (Render/Cloud SQL do not).
DATABASE_CA_CERT=
# Set to exactly "false" to run worker.js as its own process instead of
# inside the web server. Anything else keeps it in-process.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_MS=15000
MAX_JOB_RETRIES=3
STUCK_JOB_TIMEOUT_MINUTES=10
FREE_CREDITS_ON_SIGNUP=50
CREDITS_SESSION_LOG=5
CREDITS_EXTERNAL_DATA=2
CREDITS_COG_STIMULUS=5
